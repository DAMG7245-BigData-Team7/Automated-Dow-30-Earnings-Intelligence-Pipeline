            'transcript': {
                'patterns': [
                    r'transcript', r'earnings\s*call\s*transcript',
                    r'conference\s*call\s*transcript', r'prepared\s*remarks'
                ],
                'score': 70
            },
            '10-Q': {
                'patterns': [r'10-?q', r'form\s*10-?q', r'quarterly\s*report\s*on\s*form'],
                'score': 200  # High value for quarterly SEC filings
            },
            '10-K': {
                'patterns': [r'10-?k', r'form\s*10-?k', r'annual\s*report\s*on\s*form'],
                'score': -150  # Negative score for annual reports
            },
            '8-K': {
                'patterns': [r'8-?k', r'form\s*8-?k', r'current\s*report'],
                'score': 60
            }
        }

        # Advanced scoring keywords
        self.SCORING_KEYWORDS = {
            'high_value': {
                'q1': 200, 'q2': 200, 'q3': 200, 'q4': 200,
                '1q': 200, '2q': 200, '3q': 200, '4q': 200,
                'first quarter': 180, 'second quarter': 180,
                'third quarter': 180, 'fourth quarter': 180,
                'quarterly': 150, 'earnings': 100, 'financial results': 120
            },
            'medium_value': {
                'results': 40, 'press release': 30, 'earnings release': 100,
                'investor presentation': 60, 'conference call': 50
            },
            'negative_value': {
                'annual report': -200, 'sustainability': -300, 'esg': -300,
                'governance': -250, 'compensation': -250, 'biography': -250,
                'charter': -250, 'committee': -200, 'board': -150,
                'environment': -200, 'supply chain': -250, 'patent': -300,
                'glossary': -300, 'icon': -300, 'logo': -300
            }
        }
        
        # Get current and recent quarters
        self.target_periods = self._get_target_periods()
    
    def validate_dow30_companies(self, companies: List[Dict]) -> Tuple[List[Dict], Dict]:
        """Validate that companies are in the current Dow 30"""
        validation_results = {
            'valid_dow30': [],
            'invalid_companies': [],
            'removed_companies': [],
            'missing_dow30': []
        }
        
        valid_companies = []
        found_tickers = set()
        
        for company in companies:
            ticker = company.get('ticker', '').upper()
            found_tickers.add(ticker)
            
            if ticker in self.DOW_30_COMPANIES:
                validation_results['valid_dow30'].append(ticker)
                valid_companies.append(company)
                logger.info(f"✓ {ticker} - Valid Dow 30 company")
            elif ticker in self.REMOVED_COMPANIES:
                validation_results['removed_companies'].append({
                    'ticker': ticker,
                    'reason': self.REMOVED_COMPANIES[ticker]
                })
                logger.warning(f"✗ {ticker} - {self.REMOVED_COMPANIES[ticker]}")
            else:
                validation_results['invalid_companies'].append(ticker)
                logger.warning(f"✗ {ticker} - Not a Dow 30 company")
        
        # Check for missing Dow 30 companies
        for dow_ticker in self.DOW_30_COMPANIES:
            if dow_ticker not in found_tickers:
                validation_results['missing_dow30'].append(dow_ticker)
                logger.warning(f"⚠ {dow_ticker} - Missing from input list")
        
        # Save validation results
        self.session_data['dow30_validation'] = validation_results
        
        # Print validation summary
        print("\n" + "="*60)
        print("DOW 30 VALIDATION RESULTS")
        print("="*60)
        print(f"Valid Dow 30 companies: {len(validation_results['valid_dow30'])}/30")
        print(f"Invalid companies: {len(validation_results['invalid_companies'])}")
        print(f"Removed companies: {len(validation_results['removed_companies'])}")
        print(f"Missing Dow 30 companies: {len(validation_results['missing_dow30'])}")
        
        if validation_results['missing_dow30']:
            print("\n⚠ Missing Dow 30 companies:")
            for ticker in validation_results['missing_dow30']:
                print(f"  - {ticker}: {self.DOW_30_COMPANIES[ticker]}")
        
        if validation_results['removed_companies']:
            print("\n✗ Recently removed companies found:")
            for item in validation_results['removed_companies']:
                print(f"  - {item['ticker']}: {item['reason']}")
        
        print("="*60 + "\n")
        
        return valid_companies, validation_results
    
    def _get_target_periods(self) -> List[Dict]:
        """Get current and recent quarters to search for"""
        current_date = datetime.now()
        periods = []
        
        # Current year quarters
        current_year = current_date.year
        current_quarter = (current_date.month - 1) // 3 + 1
        
        # Add current quarter and previous 2 quarters
        for q_offset in range(3):
            q = current_quarter - q_offset
            year = current_year
            
            if q <= 0:
                q += 4
                year -= 1
            
            periods.append({
                'year': year,
                'quarter': q,
                'patterns': [
                    f"Q{q} {year}",
                    f"Q{q}'{str(year)[2:]}",
                    f"{year} Q{q}",
                    f"FY{year} Q{q}",
                    f"FY{str(year)[2:]} Q{q}",
                    self._quarter_to_month_range(q, year)
                ]
            })
        
        # Also add annual patterns
        periods.extend([
            {'year': current_year, 'type': 'annual', 'patterns': [f"{current_year}", f"FY{current_year}", f"FY{str(current_year)[2:]}"]},
            {'year': current_year - 1, 'type': 'annual', 'patterns': [f"{current_year - 1}", f"FY{current_year - 1}"]}
        ])
        
        return periods
    
    def _quarter_to_month_range(self, quarter: int, year: int) -> str:
        """Convert quarter to month range string"""
        quarters = {
            1: "January - March",
            2: "April - June", 
            3: "July - September",
            4: "October - December"
        }
        return f"{quarters[quarter]} {year}"
    
