    def _get_selenium_context(self, element) -> str:
        """Get context around an element using BeautifulSoup"""
        context_parts = []

        try:
            # Parent context
            parent = element.parent
            if parent:
                context_parts.append(parent.get_text(' ', strip=True))

            # Previous siblings
            prev_sibling = element.previous_sibling
            if prev_sibling and hasattr(prev_sibling, 'get_text'):
                context_parts.append(prev_sibling.get_text(' ', strip=True))

            # Heading context
            for heading in element.find_parents(['h1', 'h2', 'h3', 'h4', 'h5']):
                context_parts.append(heading.get_text(' ', strip=True))
                break

            # Table context
            table_parent = element.find_parent('table')
            if table_parent:
                context_parts.append(table_parent.get_text(' ', strip=True))

        except Exception as e:
            pass

        return ' '.join(context_parts)[:300]

    def _get_link_context_bs4(self, link_element) -> str:
        """Get context for BeautifulSoup elements"""
        context_parts = []

        try:
            parent = link_element.parent
            if parent:
                context_parts.append(parent.get_text(' ', strip=True))

            for heading in link_element.find_parents(['h1', 'h2', 'h3', 'h4']):
                context_parts.append(heading.get_text(' ', strip=True))
                break

        except:
            pass

        return ' '.join(context_parts)[:200]

    def _requests_fallback(self, ticker: str, ir_url: str, max_files: int) -> List[Dict]:
        """Optimized fallback using requests with parallel processing"""
        downloaded_files = []

        try:
            logger.info(f"Trying optimized requests fallback for {ticker}...")
            response = self.session.get(ir_url, timeout=10, verify=False)  # Reduced timeout

            if response.status_code == 200:
                soup = BeautifulSoup(response.text, 'html.parser')

                # Find PDF links more efficiently
                pdf_links_raw = soup.find_all('a', href=lambda x: x and x.lower().endswith('.pdf'))

                def process_pdf_link(link):
                    try:
                        link_text = link.get_text(' ', strip=True)
                        context = self._get_link_context_bs4(link)
                        full_url = urljoin(ir_url, link['href'])
                        combined_text = f"{link_text} {context}"
                        score = self._calculate_advanced_score(combined_text.lower())

                        # Early filter - only process high-scoring links
                        if score < 50:
                            return None

                        return {
                            'url': full_url,
                            'text': link_text,
                            'context': context,
                            'date': self._extract_date_from_text(combined_text),
                            'score': score,
                            'type': self._determine_document_type(combined_text.lower()),
                            'is_quarterly': score >= 150,
                            'source': 'requests_fallback'
                        }
                    except Exception:
                        return None

                # Process PDF links in parallel
                with ThreadPoolExecutor(max_workers=4) as executor:
                    pdf_results = list(executor.map(process_pdf_link, pdf_links_raw[:50]))  # Limit processing

                # Filter None results and sort
                pdf_links = [link for link in pdf_results if link is not None]
                pdf_links.sort(key=lambda x: x['score'], reverse=True)
                downloaded_files = pdf_links[:max_files]

                logger.info(f"Fallback found {len(downloaded_files)} files")

        except Exception as e:
            logger.debug(f"Fallback failed: {e}")

        return downloaded_files

    def _make_filename_safe(self, text: str) -> str:
        """Make filename safe"""
        if not text or text.strip() == '':
            return "document"

        safe_text = re.sub(r'[<>:"/\\|?*]', '_', text)
        safe_text = re.sub(r'\s+', '_', safe_text.strip())
        safe_text = safe_text.strip('_.')

        return safe_text[:40]

    def validate_pdf(self, filepath: Path) -> bool:
        """Validate if PDF is not corrupted"""
        try:
            with open(filepath, 'rb') as f:
                header = f.read(5)
                # Check PDF header
                if header != b'%PDF-':
                    return False
                
                # Check file size (PDFs should be at least a few KB)
                if filepath.stat().st_size < 1024:  # Less than 1KB
                    return False
                
                # Check for PDF footer
                f.seek(-100, 2)  # Go to end of file
                tail = f.read()
                if b'%%EOF' not in tail:
                    logger.warning(f"PDF may be incomplete: {filepath.name}")
                
            return True
        except Exception as e:
            logger.error(f"PDF validation error: {e}")
            return False
    
    def close(self):
        """Enhanced cleanup with memory optimization"""
        # Close Selenium driver
        if self.driver:
            try:
                self.driver.quit()
                self.driver = None
            except Exception as e:
                logger.debug(f"Error closing driver: {e}")

        # Close requests session
        if hasattr(self, 'session') and self.session:
            try:
                self.session.close()
                self.session = None
            except Exception as e:
                logger.debug(f"Error closing session: {e}")

        # Clear large data structures
        if hasattr(self, 'session_data'):
            self.session_data = None
        if hasattr(self, 'stats'):
            self.stats = None

        # Force garbage collection
        import gc
        gc.collect()
    
    def download_document_legacy(self, doc_info: Dict, company_dir: Path, ticker: str) -> bool:
        """Enhanced download with multiple strategies and validation"""
        try:
            url = doc_info['url']
            
            # Make URL absolute if relative
            if not url.startswith(('http://', 'https://')):
                base_url = self.current_ir_url
                url = urljoin(base_url, url)
                doc_info['url'] = url  # Update with absolute URL
            
            # Generate enhanced filename with scoring
            doc_type = doc_info.get('type', 'document').replace(' ', '_')
            score = doc_info.get('score', 0)
            is_quarterly = doc_info.get('is_quarterly', False)

            # Period string from extracted date or period info
            period_str = ''
            if doc_info.get('date'):
                date_obj = doc_info['date']
                quarter = ((date_obj.month - 1) // 3) + 1
                period_str = f"_Q{quarter}_{date_obj.year}"
            elif doc_info.get('period'):
                p = doc_info['period']
                if 'quarter' in p:
                    period_str = f"_Q{p['quarter']}_{p['year']}"
                else:
                    period_str = f"_{p['year']}"

            # Add quality indicators to filename
            quality_prefix = "HIGH_" if is_quarterly else "REG_"
            score_str = f"S{score:03d}_"  # Score with leading zeros

            timestamp = datetime.now().strftime('%Y%m%d')
            extension = '.pdf'  # Default
            
            # Check URL for extension
            for ext in ['.pdf', '.xlsx', '.xls', '.doc', '.docx']:
                if ext in url.lower():
                    extension = ext
                    break
            
            filename = f"{ticker}_{quality_prefix}{score_str}{doc_type}{period_str}_{timestamp}{extension}"
            filepath = company_dir / filename
            
            # Skip if exists and valid
            if filepath.exists():
                if extension == '.pdf':
                    if self.validate_pdf(filepath):
                        logger.info(f"Already exists (valid): {filename}")
                        doc_info['downloaded'] = True
                        doc_info['filename'] = filename
                        return True
                    else:
                        logger.warning(f"Existing PDF corrupted, re-downloading: {filename}")
                        filepath.unlink()  # Delete corrupted file
                else:
                    logger.info(f"Already exists: {filename}")
                    return True
            
            logger.info(f"Downloading: {filename} from {url}")
            
            # Strategy 1: Direct download with requests (with better headers)
            headers = {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36',
                'Accept': 'application/pdf,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
                'Accept-Language': 'en-US,en;q=0.5',
                'Accept-Encoding': 'gzip, deflate, br',
                'Connection': 'keep-alive',
                'Upgrade-Insecure-Requests': '1',
                'Referer': self.current_ir_url
            }
            
            # Use session to maintain cookies
            session = requests.Session()
            session.headers.update(headers)
            
            # First, try with the session
            response = session.get(url, timeout=30, verify=False, allow_redirects=True)
            response.raise_for_status()
            
            # Check if response is actually a file
            content_type = response.headers.get('content-type', '').lower()
            
            # Check if it's an HTML page (not a file)
            if 'text/html' in content_type and extension == '.pdf':
                logger.warning(f"Got HTML instead of PDF, trying Selenium: {filename}")
                
                # Strategy 2: Use Selenium to handle JavaScript
                if self.download_with_selenium(url, filepath):
                    if extension == '.pdf' and self.validate_pdf(filepath):
                        file_size_mb = filepath.stat().st_size / (1024 * 1024)
                        logger.info(f"Downloaded via Selenium: {filename} ({file_size_mb:.2f} MB)")
                        doc_info['downloaded'] = True
                        doc_info['filename'] = filename
                        doc_info['size_mb'] = file_size_mb
                        doc_info['method'] = 'selenium'
                        return True
                    else:
                        logger.error(f"Selenium download failed validation: {filename}")
                        if filepath.exists():
                            filepath.unlink()
                        return False
                            
                # Strategy 3: Try to find actual download link in the page
                self.driver.get(url)
                time.sleep(2)
                
                # Look for download buttons/links
                download_selectors = [
                    "a[download]",
                    "a[href*='.pdf']",
                    "a:contains('Download')",
                    "button:contains('Download')",
                    "a.download-link",
                    "iframe"  # Sometimes PDFs are in iframes
                ]
                
                for selector in download_selectors:
                    try:
                        elements = self.driver.find_elements(By.CSS_SELECTOR, selector)
                        for elem in elements:
                            href = elem.get_attribute('href') or elem.get_attribute('src')
                            if href and ('.pdf' in href.lower() or 'download' in href.lower()):
                                logger.info(f"Found actual download link: {href}")
                                # Recursive call with the actual download URL
                                doc_info['url'] = href
                                return self.download_document(doc_info, company_dir, ticker)
                    except:
                        continue
                
                logger.error(f"Could not find download link for: {filename}")
                return False
                
            else:
                # Save the file content
                with open(filepath, 'wb') as f:
                    f.write(response.content)
                
                # Validate if PDF
                if extension == '.pdf':
                    if not self.validate_pdf(filepath):
                        logger.error(f"Downloaded PDF is corrupted: {filename}")
                        
                        # Check if content is actually HTML
                        try:
                            with open(filepath, 'r', encoding='utf-8') as f:
                                content = f.read(1000)
                                if '<html' in content.lower() or '<!doctype' in content.lower():
                                    logger.error(f"Downloaded HTML instead of PDF")
                                    filepath.unlink()
                                    
                                    # Try Selenium approach
                                    logger.info(f"Retrying with Selenium: {filename}")
                                    if self.download_with_selenium(url, filepath):
                                        if self.validate_pdf(filepath):
                                            file_size_mb = filepath.stat().st_size / (1024 * 1024)
                                            logger.info(f"Successfully downloaded via Selenium: {filename} ({file_size_mb:.2f} MB)")
                                            doc_info['downloaded'] = True
                                            doc_info['filename'] = filename
                                            doc_info['size_mb'] = file_size_mb
                                            doc_info['method'] = 'selenium-retry'
                                            return True
                        except:
                            pass
                        
                        if filepath.exists():
                            filepath.unlink()
                        return False
                
                file_size_mb = filepath.stat().st_size / (1024 * 1024)
                
                # Check file size
                if file_size_mb < 0.01:  # Less than 10KB
                    logger.warning(f"File unusually small: {filename} ({file_size_mb:.2f} MB)")
                    filepath.unlink()
                    return False
                
                logger.info(f"Downloaded successfully: {filename} ({file_size_mb:.2f} MB)")
                doc_info['downloaded'] = True
                doc_info['filename'] = filename
                doc_info['size_mb'] = file_size_mb
                doc_info['method'] = 'requests'
                
                return True
                
        except requests.exceptions.RequestException as e:
            logger.error(f"Download request failed for {url}: {e}")
            doc_info['downloaded'] = False
            doc_info['error'] = str(e)
            return False
            
        except Exception as e:
            logger.error(f"Download failed: {e}")
            doc_info['downloaded'] = False
            doc_info['error'] = str(e)
            return False
    
    def process_company(self, company_data: Dict) -> Dict:
