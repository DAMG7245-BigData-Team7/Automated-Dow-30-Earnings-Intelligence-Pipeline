    def _analyze_link(self, element, href: str, text: str, period: Dict = None) -> Optional[Dict]:
        """Advanced analysis of link relevance with comprehensive scoring"""
        if not href:
            return None

        # Skip javascript and mailto
        if href.startswith(('javascript:', 'mailto:')):
            return None

        # Get enhanced context
        context = self._get_enhanced_context(element)
        combined_text = f"{href} {text} {context}".lower()

        # Calculate comprehensive score
        total_score = self._calculate_advanced_score(combined_text, period)

        # Determine document type
        doc_type = self._determine_document_type(combined_text)

        # Extract date from context
        extracted_date = self._extract_date_from_text(combined_text)

        # File extension validation
        valid_ext = any(ext in href.lower() for ext in ['.pdf', '.xlsx', '.xls', '.doc', '.docx'])
        if valid_ext:
            total_score += 20

        # Optimized threshold with early filtering
        if total_score > 75:  # Raised threshold for better quality
            return {
                'url': href,
                'text': text or 'Document',
                'context': context,
                'type': doc_type,
                'period': period,
                'score': total_score,
                'date': extracted_date,
                'is_quarterly': total_score >= 150  # Higher confidence threshold
            }

        return None

    def _get_enhanced_context(self, element) -> str:
        """Get enhanced context around an element using Selenium"""
        context_parts = []

        try:
            # Get parent text
            parent = element.find_element(By.XPATH, "..")
            if parent:
                parent_text = parent.text.strip()
                if parent_text and len(parent_text) < 200:
                    context_parts.append(parent_text)

            # Get table row context
            try:
                row = element.find_element(By.XPATH, "./ancestor::tr[1]")
                if row:
                    row_text = row.text.strip()
                    if row_text and len(row_text) < 300:
                        context_parts.append(row_text)
            except:
                pass

            # Get heading context
            try:
                for h_level in ['h1', 'h2', 'h3', 'h4', 'h5']:
                    heading = element.find_element(By.XPATH, f"./preceding::{h_level}[1]")
                    if heading:
                        heading_text = heading.text.strip()
                        if heading_text and len(heading_text) < 100:
                            context_parts.append(heading_text)
                        break
            except:
                pass

        except Exception as e:
            logger.debug(f"Error getting context: {e}")

        return ' '.join(context_parts)[:300]

    def _calculate_advanced_score(self, combined_text: str, period: Dict = None) -> int:
        """Optimized relevance score calculation with caching and early returns"""
        if not combined_text:
            return 0

        score = 0
        text_lower = combined_text.lower()  # Convert once

        # Early exit for clearly irrelevant content
        negative_keywords = ['sustainability', 'esg', 'governance', 'biography', 'charter']
        if any(neg in text_lower for neg in negative_keywords):
            return -100

        # Base period score
        if period:
            score += 50

        # Optimized keyword scoring with compiled regex
        # High-value keywords (quarterly indicators)
        high_value_patterns = r'\b(q[1-4]|quarter|quarterly|earnings|financial results)\b'
        if re.search(high_value_patterns, text_lower):
            score += 150

        # PDF bonus
        if '.pdf' in text_lower:
            score += 50

        # Recent year bonus (current and last 2 years)
        current_year = datetime.now().year
        year_pattern = f'\b({current_year}|{current_year-1}|{current_year-2})\b'
        if re.search(year_pattern, text_lower):
            score += 75

        # 10-Q forms (high priority)
        if re.search(r'10-?q', text_lower):
            score += 200

        # 10-K forms (penalty for annual)
        elif re.search(r'10-?k', text_lower):
            score -= 150

        # Date recency bonus (optimized)
        extracted_date = self._extract_date_from_text(text_lower)
        if extracted_date:
            days_old = (datetime.now() - extracted_date).days
            if days_old <= 90:
                score += 100
            elif days_old <= 180:
                score += 50

        return score

    def _determine_document_type(self, combined_text: str) -> str:
        """Determine the type of document based on content analysis"""
        # Check each document type pattern
        for doc_type, config in self.DOC_PATTERNS.items():
            for pattern in config['patterns']:
                if re.search(pattern, combined_text):
                    return doc_type

        # Fallback type detection
        if 'press release' in combined_text:
            return 'earnings'
        elif 'presentation' in combined_text or 'slides' in combined_text:
            return 'presentation'
        elif 'transcript' in combined_text:
            return 'transcript'
        elif '.pdf' in combined_text:
            return 'document'

        return 'unknown'

    def _extract_date_from_text(self, text: str) -> Optional[datetime]:
        """Enhanced date extraction from text"""
        if not text:
            return None

        try:
            # Common date patterns
            date_patterns = [
                (r'(\d{4})-(\d{1,2})-(\d{1,2})', '%Y-%m-%d'),
                (r'(\d{1,2})/(\d{1,2})/(\d{4})', '%m/%d/%Y'),
                (r'(\d{1,2})-(\d{1,2})-(\d{4})', '%m-%d-%Y'),
                (r'(january|february|march|april|may|june|july|august|september|october|november|december)\s+(\d{1,2}),?\s+(\d{4})', '%B %d %Y'),
                (r'(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\s+(\d{1,2}),?\s+(\d{4})', '%b %d %Y')
            ]

            for pattern, date_format in date_patterns:
                match = re.search(pattern, text, re.IGNORECASE)
                if match:
                    try:
                        if len(match.groups()) == 3:
                            date_str = match.group().replace(',', '')
                            parsed_date = datetime.strptime(date_str, date_format)
                            if 2020 <= parsed_date.year <= 2026:
                                return parsed_date
                    except ValueError:
                        continue

            # Year + Quarter pattern
            year_quarter = re.search(r'(20[2-3][0-9])\s*q([1-4])', text, re.IGNORECASE)
            if year_quarter:
                year = int(year_quarter.group(1))
                quarter = int(year_quarter.group(2))
                month = quarter * 3
                return datetime(year, month, 15)  # Mid-quarter date

            # Just year
            year_match = re.search(r'\b(20[2-3][0-9])\b', text)
            if year_match:
                year = int(year_match.group(1))
                return datetime(year, 6, 15)  # Mid-year date

        except Exception as e:
            logger.debug(f"Date extraction error: {e}")

        return None

    def _selenium_quarterly_search(self, ticker: str) -> List[Dict]:
        """Optimized Selenium search for quarterly reports with parallel processing"""
        quarterly_links = []

        try:
            # Get page source and parse with BeautifulSoup
            page_source = self.driver.page_source
            soup = BeautifulSoup(page_source, 'html.parser')

            # Optimized quarterly keywords (reduced set)
            quarterly_keywords = {'q1', 'q2', 'q3', 'q4', 'quarter', 'quarterly', 'earnings', '10-q'}

            all_links = soup.find_all('a', href=True)[:100]  # Limit to first 100 links for performance

            # Process links in smaller batches for better performance
            def process_link_batch(links_batch):
                batch_results = []
                for link in links_batch:
                    try:
                        link_text = link.get_text(' ', strip=True).lower()
                        link_href = link.get('href', '').lower()

                        # Quick check before expensive operations
                        if not link_href.endswith('.pdf'):
                            continue

                        # Fast keyword check using set intersection
                        text_words = set(link_text.split())
                        if not text_words.intersection(quarterly_keywords):
                            continue

                        context = self._get_selenium_context(link)
                        combined_text = f"{link_text} {context} {link_href}".lower()
                        full_url = urljoin(self.driver.current_url, link['href'])

                        batch_results.append({
                            'url': full_url,
                            'text': link_text,
                            'context': context,
                            'date': self._extract_date_from_text(combined_text),
                            'score': self._calculate_advanced_score(combined_text),
                            'type': 'quarterly',
                            'is_quarterly': True,
                            'source': 'selenium_direct'
                        })
                    except Exception:
                        continue
                return batch_results

            # Process links in parallel batches
            batch_size = 25
            link_batches = [all_links[i:i + batch_size] for i in range(0, len(all_links), batch_size)]

            with ThreadPoolExecutor(max_workers=3) as executor:
                future_results = [executor.submit(process_link_batch, batch) for batch in link_batches]
                for future in as_completed(future_results):
                    quarterly_links.extend(future.result())

            logger.info(f"Found {len(quarterly_links)} direct quarterly PDF links")

        except Exception as e:
            logger.debug(f"Error finding quarterly links: {e}")

        return quarterly_links

    def _navigate_to_financial_sections(self) -> List[Dict]:
        """Navigate to common financial sections"""
        financial_docs = []

        try:
