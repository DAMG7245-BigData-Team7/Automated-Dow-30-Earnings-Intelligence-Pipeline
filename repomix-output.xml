    def find_ir_page_multi_strategy(self, ticker: str, name: str, url: str) -> Dict:
        """Use multiple strategies to find IR page"""
        result = {
            'ticker': ticker,
            'company_name': name,
            'company_url': url,
            'ir_page_found': False,
            'ir_url': None,
            'ir_page_title': None,
            'strategy_used': None,
            'verification_score': 0,
