    def run(self):
        """Main execution"""
        # Load IR results
        with open(self.input_file, 'r') as f:
            data = json.load(f)
            companies = [c for c in data.get('companies_processed', []) if c.get('ir_page_found')]
        
        # Validate Dow 30 companies if enabled
        if self.validate_dow30:
            companies, validation = self.validate_dow30_companies(companies)
            
            # Ask user if they want to continue with only valid companies
            if validation['invalid_companies'] or validation['removed_companies']:
                response = input("\n⚠ Found non-Dow 30 companies. Process only valid Dow 30? (y/n): ")
                if response.lower() != 'y':
                    print("Exiting...")
                    return
        
        # Setup driver
        self.setup_driver()
        
        try:
            print(f"\n{'='*60}")
            print("ENHANCED DOW 30 EARNINGS DOCUMENT DOWNLOADER")
            print(f"{'='*60}\n")
            print(f"Processing {len(companies)} companies (All valid Dow 30)")
            print(f"Target periods: {', '.join([f'Q{p['quarter']} {p['year']}' for p in self.target_periods[:3] if 'quarter' in p])}\n")
            
            # Process each company with memory optimization
            for i, company in enumerate(companies, 1):
                print(f"\n[{i}/{len(companies)}] {company['ticker']} - {company.get('company_name', company['ticker'])}")
                print("-" * 40)

                result = self.process_company(company)
                self.session_data['companies'].append(result)

                print(f"Found: {result['documents_found']} documents")
                print(f"Downloaded: {result['documents_downloaded']} documents")

                # Memory cleanup after each company
                if 'documents' in result:
                    # Keep only essential data
                    result['documents'] = [{
                        'url': doc.get('url', ''),
                        'filename': doc.get('filename', ''),
                        'score': doc.get('score', 0),
                        'downloaded': doc.get('downloaded', False)
                    } for doc in result['documents'] if doc.get('downloaded')]

                # Optimized rate limiting
                time.sleep(2)

                # Restart driver and force cleanup every 8 companies
                if i % 8 == 0:
                    logger.info("Restarting driver and cleaning memory...")
                    self.setup_driver()

                    # Force garbage collection
                    import gc
                    gc.collect()

            # Generate enhanced final summary
            self._generate_final_summary()

            # Save results with memory optimization
            self.save_results()

        except KeyboardInterrupt:
            logger.info("Process interrupted by user")
        except Exception as e:
            logger.error(f"Fatal error in main process: {e}")
        finally:
            self.close()

            # Final memory cleanup
            import gc
            gc.collect()
    
