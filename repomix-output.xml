#!/usr/bin/env python3
"""
Task 4 — Docling PDF Parser (CSV-driven)
----------------------------------------
Reads pdf_files_reference.csv and parses each PDF listed there.

Expected CSV columns:
  ticker, folder, file_name

Usage:
  docker compose run task_4_parse_unstructured --csv data/reference/pdf_files_reference.csv
"""
from __future__ import annotations
import argparse
import concurrent.futures
import json
import csv  
import logging
import platform
import sys
import time
from pathlib import Path
from typing import List
import numpy as np
from pdf2image import convert_from_path
from rapidocr_onnxruntime import RapidOCR
from docling.datamodel.base_models import InputFormat
from docling.datamodel.pipeline_options import PdfPipelineOptions
from docling.document_converter import DocumentConverter, PdfFormatOption
from docling_core.types.doc import PictureItem, TableItem

# -------------------------------------------------------------------
# Configuration
# -------------------------------------------------------------------
DATA_DIR = Path("data")
CSV_PATH = DATA_DIR / "reference" / "pdf_files_reference.csv"
PARSED_DIR = DATA_DIR / "parsed"
LOG_DIR = PARSED_DIR / "logs"
PARSED_DIR.mkdir(parents=True, exist_ok=True)
LOG_DIR.mkdir(parents=True, exist_ok=True)

logging.basicConfig(
    level=logging.INFO, format="%(asctime)s | %(levelname)s | %(message)s"
)
log = logging.getLogger("parse_from_csv")


def parse_pdf(pdf_path: Path, parsed_dir: Path):
    """Parse one PDF using Docling."""
    try:
        opts = PdfPipelineOptions(
            force_ocr=False,
            ocr_engine=None,  # 🚫 disable EasyOCR
            generate_picture_images=True,
            generate_page_images=False,
        )
        converter = DocumentConverter(
            format_options={InputFormat.PDF: PdfFormatOption(pipeline_options=opts)}
        )

        log.info(f"Processing {pdf_path} ...")
        conv = converter.convert(pdf_path)
        doc = conv.document

        # Output folders
        base = parsed_dir / pdf_path.parent.name
        (base / "text").mkdir(parents=True, exist_ok=True)
        (base / "json").mkdir(parents=True, exist_ok=True)
        (base / "markdown").mkdir(parents=True, exist_ok=True)
        (base / "tables").mkdir(parents=True, exist_ok=True)
        (base / "images").mkdir(parents=True, exist_ok=True)

        # Save JSON
        (base / "json" / f"{pdf_path.stem}.json").write_text(
            json.dumps(doc.model_dump(mode="json"), indent=2, ensure_ascii=False),
            encoding="utf-8",
        )

        # Save Markdown
        (base / "markdown" / f"{pdf_path.stem}.md").write_text(
            doc.export_to_markdown(), encoding="utf-8"
        )

        # Save text
        text_blocks = []
        for p in doc.pages.values():
            for b in getattr(p, "blocks", []):
                if hasattr(b, "text") and b.text:
                    text_blocks.append(b.text)
        (base / "text" / f"{pdf_path.stem}.txt").write_text(
            "\n\n".join(text_blocks), encoding="utf-8"
        )

        # Save tables
        for i, (el, _) in enumerate(doc.iterate_items()):
            if isinstance(el, TableItem):
                try:
                    df = el.export_to_dataframe(doc=doc)
                    df.to_csv(base / "tables" / f"{pdf_path.stem}-table-{i+1:03}.csv", index=False)
                except Exception as e:
                    log.warning(f"Table save failed: {e}")

        # Save images
        for i, (el, _) in enumerate(doc.iterate_items()):
            if isinstance(el, PictureItem):
                try:
                    img = el.get_image(doc)
                    img.save(base / "images" / f"{pdf_path.stem}-img-{i+1:03}.png", "PNG")
                except Exception as e:
                    log.warning(f"Image save failed: {e}")

        log.info(f"✅ Done {pdf_path.name}")
        return {"pdf": str(pdf_path), "status": "ok"}

    except Exception as e:
        log.error(f"❌ Failed {pdf_path}: {e}")
        return {"pdf": str(pdf_path), "status": "error", "error": str(e)}


def main(csv_path: Path, concurrency: int = 3):
    if not csv_path.exists():
        log.error(f"CSV not found: {csv_path}")
        sys.exit(1)

    rows = []
    with open(csv_path, newline="", encoding="utf-8") as f:
        reader = csv.DictReader(f)
        for row in reader:
            pdf_path = Path(row["folder"]) / row["file_name"]
            if pdf_path.exists():
                rows.append(pdf_path)
            else:
                log.warning(f"Missing: {pdf_path}")

    log.info(f"Found {len(rows)} PDFs from {csv_path}")
    start = time.time()
    results = []

    with concurrent.futures.ProcessPoolExecutor(max_workers=concurrency) as ex:
        futures = {ex.submit(parse_pdf, path, PARSED_DIR): path for path in rows}
        for fut in concurrent.futures.as_completed(futures):
            f = futures[fut]
            try:
                r = fut.result()
                results.append(r)
            except Exception as e:
                results.append({"pdf": str(f), "status": "error", "error": str(e)})

    summary = {
        "total": len(rows),
        "elapsed_s": round(time.time() - start, 2),
        "results": results,
    }
    (PARSED_DIR / "run_summary.json").write_text(json.dumps(summary, indent=2))
    log.info("✅ Completed parsing all PDFs.")


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--csv", type=str, default=str(CSV_PATH))
    parser.add_argument("--concurrency", type=int, default=3)
    args = parser.parse_args()
    main(Path(args.csv), args.concurrency)
