    }
    
    # Companies removed from Dow 30 (for reference)
    REMOVED_COMPANIES = {
        'INTC': 'Intel Corporation (Removed Nov 8, 2024)',
        'DOW': 'Dow Inc. (Removed Nov 8, 2024)',
        'WBA': 'Walgreens Boots Alliance (Removed Feb 26, 2024)',
        'RTX': 'Raytheon Technologies (Removed Aug 31, 2020)',
        'XOM': 'ExxonMobil (Removed Aug 31, 2020)',
        'PFE': 'Pfizer (Removed Aug 31, 2020)'
    }
    
    def __init__(self, input_file: str = "output/ir_finder_results.json",
                 output_dir: str = "data/raw", headless: bool = True,
                 validate_dow30: bool = True):
        self.input_file = Path(input_file)
        self.output_dir = Path(output_dir)
        self.output_dir.mkdir(exist_ok=True)
        self.headless = headless
        self.validate_dow30 = validate_dow30
        self.driver = None
        self.session_data = {
            'start_time': datetime.now().isoformat(),
            'dow30_validation': {},
            'companies': []
        }

        # Setup requests session for downloads
        self.session = requests.Session()
        self.session.headers.update({
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
        })

        # Statistics for tracking
        self.stats = {
            'processed': 0,
            'quarterly_success': 0,
            'fallback_success': 0,
            'failed': [],
            'files_downloaded': 0
        }
        
        # Advanced document patterns with scoring weights
        self.DOC_PATTERNS = {
            'earnings': {
                'patterns': [
                    r'earnings\s*release', r'earnings\s*report', r'financial\s*results',
                    r'quarterly\s*results', r'q[1-4]\s*20\d{2}', r'quarterly\s*earnings',
                    r'results\s*of\s*operations', r'financial\s*performance'
                ],
