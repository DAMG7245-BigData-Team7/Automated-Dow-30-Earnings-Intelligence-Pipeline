    def find_latest_earnings(self, ticker: str, ir_url: str) -> List[Dict]:
        """Find latest earnings documents with enhanced error handling and retries"""
        documents = []
        max_retries = 3
        retry_delay = 2

        try:
            for attempt in range(max_retries):
                try:
                    logger.info(f"Processing {ticker}: {ir_url} (attempt {attempt + 1}/{max_retries})")

                    # Enhanced page loading with timeout handling
                    self.driver.get(ir_url)

                    # Reduced wait time with better error handling
                    try:
                        WebDriverWait(self.driver, 8).until(
                            EC.presence_of_element_located((By.TAG_NAME, "body"))
                        )
                        time.sleep(1)  # Reduced from 3 seconds
                        break  # Success, exit retry loop
                    except TimeoutException:
                        logger.warning(f"Page load timeout for {ticker}, attempt {attempt + 1}")
                        if attempt < max_retries - 1:
                            time.sleep(retry_delay)
                            continue
                        else:
                            raise
                except WebDriverException as e:
                    logger.warning(f"WebDriver error for {ticker}: {e}")
                    if attempt < max_retries - 1:
                        time.sleep(retry_delay)
                        self.setup_driver()  # Restart driver on error
                        continue
                    else:
                        raise

            # STRATEGY 1: Advanced Selenium quarterly search
            quarterly_docs = self._selenium_quarterly_search(ticker)
            if quarterly_docs:
                documents.extend(quarterly_docs)
                self.stats['quarterly_success'] += 1
                logger.info(f"Found {len(quarterly_docs)} quarterly documents via Selenium")

            # STRATEGY 2: Navigate to financial sections
            if len(documents) < 3:
                section_docs = self._navigate_to_financial_sections()
                documents.extend(section_docs)

            # STRATEGY 3: Find all PDFs with context scoring
            if len(documents) < 3:
                pdf_docs = self._find_all_pdfs_with_context()
                documents.extend(pdf_docs)

            # STRATEGY 4: Fallback requests scraping if not enough found
            if len(documents) < 2:
                fallback_docs = self._requests_fallback(ticker, ir_url, 3 - len(documents))
                if fallback_docs:
                    documents.extend(fallback_docs)
                    self.stats['fallback_success'] += 1

            # Deduplicate and score
            seen_urls = set()
            unique_docs = []
            for doc in documents:
                if doc['url'] not in seen_urls and doc.get('score', 0) > 50:
                    seen_urls.add(doc['url'])
                    unique_docs.append(doc)

            # Sort by quarterly priority, then score, then date
            def sort_key(doc):
                is_quarterly = doc.get('is_quarterly', False)
                score = doc.get('score', 0)
                date = doc.get('date')
                date_score = 0
                if date:
                    days_old = (datetime.now() - date).days
                    date_score = max(0, 365 - days_old)
                return (is_quarterly, score, date_score)

            unique_docs.sort(key=sort_key, reverse=True)

            # Log results
            logger.info(f"Found {len(unique_docs)} relevant documents for {ticker}")
            for i, doc in enumerate(unique_docs[:5], 1):
                logger.info(f"  {i}. [Score: {doc.get('score', 0)}] {doc.get('type', 'unknown')} - {doc.get('text', 'No title')[:50]}")

            return unique_docs[:8]

        except Exception as e:
            logger.error(f"Failed to process {ticker} after {max_retries} attempts: {e}")
            self.stats['failed'].append(ticker)

            # Try to restart driver for next company
            try:
                self.setup_driver()
            except Exception as driver_error:
                logger.error(f"Failed to restart driver: {driver_error}")

            return []
    
    def _download_pdf_selenium(self, doc_info: Dict, company_dir: Path, file_type: str) -> bool:
        """Download PDF using Selenium-found URL"""
        try:
            # Create safe filename
            safe_title = self._make_filename_safe(doc_info['text'][:40])
            date_str = doc_info['date'].strftime('%Y-%m-%d') if doc_info.get('date') else 'NoDate'
            score = doc_info.get('score', 0)
            filename = f"{date_str}_{file_type}_S{score:03d}_{safe_title}.pdf"
            filepath = company_dir / filename

            # Skip if exists
            if filepath.exists():
                logger.info(f"File exists: {filename}")
                return True

            # Download using requests
            response = self.session.get(doc_info['url'], timeout=30, verify=False)

            if response.status_code != 200:
                return False

            # Validate PDF
            if not response.content.startswith(b'%PDF'):
                return False

            # Size check
            size_kb = len(response.content) / 1024
            if size_kb < 10 or size_kb > 50000:
                return False

            # Save file
            with open(filepath, 'wb') as f:
                f.write(response.content)

            logger.info(f"✅ {file_type}: {size_kb:.0f}KB - {filename}")
            return True

        except Exception as e:
            logger.debug(f"Download failed: {e}")
            return False
    
    def _enhanced_download_with_fallback(self, doc_info: Dict, filepath: Path) -> bool:
        """Enhanced download with robust error handling and retries"""
        max_retries = 3

        for attempt in range(max_retries):
            try:
                url = doc_info['url']
                logger.debug(f"Download attempt {attempt + 1}/{max_retries} for {filepath.name}")

                # Strategy 1: Direct download with optimized requests
                headers = {
                    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
                    'Accept': 'application/pdf,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
                    'Accept-Language': 'en-US,en;q=0.5',
                    'Connection': 'keep-alive',
                    'Referer': self.current_ir_url
                }

                # Reduced timeout for faster failures
                response = self.session.get(url, timeout=15, verify=False, allow_redirects=True, headers=headers)
                response.raise_for_status()

                # Check content type
                content_type = response.headers.get('content-type', '').lower()

                # If HTML instead of PDF, try Selenium
                if 'text/html' in content_type and filepath.suffix.lower() == '.pdf':
                    logger.warning(f"Got HTML instead of PDF, trying Selenium")
                    return self._selenium_download_strategy(url, filepath)

                # Save file
                with open(filepath, 'wb') as f:
                    f.write(response.content)

                # Validate PDF
                if filepath.suffix.lower() == '.pdf':
                    if not self.validate_pdf(filepath):
                        logger.error(f"Downloaded PDF is corrupted")
                        filepath.unlink()
                        return self._selenium_download_strategy(url, filepath)

                size_mb = filepath.stat().st_size / (1024 * 1024)

                # Check file size
                if size_mb < 0.01:
                    logger.warning(f"File unusually small: {size_mb:.2f} MB")
                    filepath.unlink()
                    return False

                logger.info(f"Downloaded successfully: {filepath.name} ({size_mb:.2f} MB)")
                return True

            except requests.exceptions.RequestException as e:
                logger.warning(f"Download attempt {attempt + 1} failed: {e}")
                if attempt < max_retries - 1:
                    time.sleep(1)  # Brief pause before retry
                    continue
                else:
                    logger.error(f"All download attempts failed for {filepath.name}")
                    return False
            except Exception as e:
                logger.error(f"Unexpected download error: {e}")
                return False

        return False

    def _selenium_download_strategy(self, url: str, filepath: Path) -> bool:
        """Download using Selenium for JavaScript-heavy pages"""
        try:
            # Configure Chrome for downloads
            self.driver.execute_cdp_cmd("Page.setDownloadBehavior", {
                "behavior": "allow",
                "downloadPath": str(filepath.parent.absolute())
            })

            # Navigate to URL
            self.driver.get(url)
            time.sleep(5)

            # Check if file was downloaded
            download_dir = filepath.parent
            for file in download_dir.glob("*.pdf"):
                if file.stat().st_mtime > time.time() - 10:
                    file.rename(filepath)
                    return True

            # Try to find actual download link
            download_selectors = [
                "a[download]",
                "a[href*='.pdf']",
                "a:contains('Download')",
                "button:contains('Download')",
                "iframe"
            ]

            for selector in download_selectors:
                try:
                    elements = self.driver.find_elements(By.CSS_SELECTOR, selector)
                    for elem in elements:
                        href = elem.get_attribute('href') or elem.get_attribute('src')
                        if href and ('.pdf' in href.lower() or 'download' in href.lower()):
                            logger.info(f"Found actual download link: {href}")
                            # Try direct download with new URL
                            response = self.session.get(href, timeout=30, verify=False)
                            if response.status_code == 200:
                                with open(filepath, 'wb') as f:
                                    f.write(response.content)
                                return True
                except:
                    continue

            return False

        except Exception as e:
            logger.error(f"Selenium download failed: {e}")
            return False
    
